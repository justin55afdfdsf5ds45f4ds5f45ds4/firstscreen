{
  "manifest_version": 3,
  "name": "FirstScreen",
  "version": "1.0.0",
  "description": "See what a customer sees on the first phone screen of any business website, and what to fix. Gemini Nano on your device, cloud when it isn't there.",
  "permissions": ["sidePanel", "activeTab", "debugger", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open FirstScreen" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
